# ==============================================================================
# PRAMAAN (Phase 0) — Environment Configuration Template
# NOTE: Copy this file to '.env' for local development. Never commit '.env'.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Service Identifiers
PROJECT_NAME="PRAMAAN Core Backend"
API_V1_PREFIX=/api/v1
APP_HOST=0.0.0.0
APP_PORT=8000

# Security & CORS (Comma-separated origins, or '*' for open development)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"
SECRET_KEY=change-this-in-production-use-a-secure-random-token-here

# Database (PostgreSQL) — Local Docker default or SQLite fallback
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql://pramaan_user:pramaan_dev_password@localhost:5432/pramaan_db
TEST_DATABASE_URL=sqlite:///:memory:

# Redis (Job Queue & Cache)
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 / MinIO Compatible)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=pramaan_minio_admin
S3_SECRET_KEY=pramaan_minio_password
S3_BUCKET_NAME=pramaan-evidence-assets
S3_REGION=us-east-1
STORAGE_BASE_DIR=./storage

# Worker Configuration
WORKER_CONCURRENCY=2
WORKER_TASK_TIMEOUT_SECONDS=300

