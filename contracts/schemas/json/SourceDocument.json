{
  "additionalProperties": false,
  "description": "Model 6: External reference material retrieved during verification.",
  "properties": {
    "id": {
      "description": "ID with format doc_<uuid4>",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "url": {
      "pattern": "^https?://",
      "title": "Url",
      "type": "string"
    },
    "domain": {
      "minLength": 1,
      "title": "Domain",
      "type": "string"
    },
    "author": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author"
    },
    "publisher": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publisher"
    },
    "published_date": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published Date"
    },
    "retrieval_timestamp": {
      "format": "date-time",
      "title": "Retrieval Timestamp",
      "type": "string"
    },
    "content_snippet": {
      "minLength": 10,
      "title": "Content Snippet",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "source_reliability_score": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Reliability Score"
    },
    "full_text_storage_uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Full Text Storage Uri"
    }
  },
  "required": [
    "id",
    "title",
    "url",
    "domain",
    "retrieval_timestamp",
    "content_snippet",
    "content_sha256"
  ],
  "title": "SourceDocument",
  "type": "object"
}